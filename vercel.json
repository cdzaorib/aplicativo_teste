{
  "buildCommand": "npx expo export -p web && cp \"dist/+not-found.html\" dist/404.html",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    { "source": "/presente/:codigo", "destination": "/presente/[codigo].html" },
    { "source": "/item/:id", "destination": "/item/[id].html" },
    { "source": "/preco/:catalogoId", "destination": "/preco/[catalogoId].html" }
  ]
}
